# =============================================================================
# Deribit MCP Server — environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Every setting here matches a field in `src/config.py`.
#
# Minimum secrets for the Docker dashboard setup:
# - MCP_SHARED_SECRET: required because docker-compose runs HTTP MCP.
# - DERIBIT_EVENT_ADMIN_TOKEN: required for dashboard JSON, news push, and outbox admin flows.
# - DERIBIT_API_KEY / DERIBIT_API_SECRET: required for private/account/trading
#   endpoints; public market-data endpoints can run without them.
# =============================================================================

# -----------------------------------------------------------------------------
# Deribit API (https://www.deribit.com/account/BTC/api)
# Leave these empty for unauthenticated public market-data checks. Fill both
# for account/private endpoints, alerts that need account state, or trading.
# -----------------------------------------------------------------------------
DERIBIT_API_KEY=
DERIBIT_API_SECRET=
# Optional second pair targeting test.deribit.com. When DERIBIT_TEST_MODE=true
# AND DERIBIT_API_KEY_TESTNET is non-empty, the server uses the _TESTNET pair;
# otherwise it falls back to the base pair. Lets operators keep both nets'
# credentials persistent and toggle nets via DERIBIT_TEST_MODE alone.
DERIBIT_API_KEY_TESTNET=
DERIBIT_API_SECRET_TESTNET=
# true  -> connects to test.deribit.com (testnet, recommended for first runs)
# false -> connects to www.deribit.com  (mainnet, real money)
DERIBIT_TEST_MODE=true

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# Path inside the container; mount a host directory at this location for
# persistence across restarts (see docker-compose.yml `volumes`).
DERIBIT_DB_PATH=/data/deribit.db

# -----------------------------------------------------------------------------
# Trading safety — required if DERIBIT_TRADING_ENABLED=true
# -----------------------------------------------------------------------------
# Master switch. Leave false unless you have explicitly reviewed the limits
# below; mutating tools (place/cancel/edit order) refuse to run while this
# is false.
DERIBIT_TRADING_ENABLED=false
# Max order amount per family. These example caps are intentionally small for
# a safe first run; raise them only for a reviewed testnet smoke run or live
# strategy. Deribit denominates "amount" differently per family:
# inverse = USD, linear = base coin, options = contracts.
DERIBIT_MAX_AMOUNT_INVERSE=100
DERIBIT_MAX_AMOUNT_LINEAR=1
DERIBIT_MAX_AMOUNT_OPTION=1
# Hard cap on USD notional per single order, evaluated after amount validation.
DERIBIT_MAX_NOTIONAL_USD=1000

# -----------------------------------------------------------------------------
# MCP transport
# -----------------------------------------------------------------------------
# stdio  -> default for direct local launchers
# http   -> exposes a Streamable-HTTP endpoint at /mcp behind a shared secret
# docker-compose.yml intentionally overrides this to http.
MCP_TRANSPORT=stdio
MCP_HTTP_JSON_RESPONSE=false
# Required when MCP_TRANSPORT=http. Generate a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_SHARED_SECRET=

# -----------------------------------------------------------------------------
# Event outbox, news, and dashboard API
# -----------------------------------------------------------------------------
# Bearer token for admin routes: consumer registration, news save/push, and
# dashboard JSON/news-push actions. Use a long random string; rotate when leaked.
# Required when MCP_TRANSPORT=http and you intend to use sidecar/dashboard flows.
DERIBIT_EVENT_ADMIN_TOKEN=
DERIBIT_EVENT_RETENTION_DAYS=7
DERIBIT_EVENT_STREAM_CLAIM_SECONDS=90
# Authenticated Deribit user-change streams are mirrored into the outbox so
# order fills, stop triggers, cancellations, and rejects wake the agent session.
DERIBIT_TRADING_EVENT_OUTBOX_ENABLED=true
DERIBIT_TRADING_EVENT_CHANNELS=user.changes.future.any.100ms,user.changes.option.any.100ms,user.changes.spot.any.100ms,user.changes.future_combo.any.100ms,user.changes.option_combo.any.100ms

# -----------------------------------------------------------------------------
# Telegram notifications (optional)
# -----------------------------------------------------------------------------
# Create a bot via @BotFather, then talk to it once and read the chat_id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Alert engine
# -----------------------------------------------------------------------------
ALERT_CHECK_INTERVAL=1.0
MAX_ALERTS=100

# -----------------------------------------------------------------------------
# Market streams (orderbook + liquidations)
# -----------------------------------------------------------------------------
# Orderbook subscription cadence: raw | 100ms | agg2
DERIBIT_ORDERBOOK_INTERVAL=100ms
DERIBIT_ORDERBOOK_DIFF_RETENTION_SECONDS=300
DERIBIT_ORDERBOOK_IDLE_UNSUBSCRIBE_SECONDS=300
DERIBIT_LIQUIDATION_BUFFER_SIZE=1000
# Deribit documents a 500-channel WebSocket subscription limit. Keep a safety
# margin so agents fail locally before hitting the exchange cap.
DERIBIT_WS_MAX_ACTIVE_CHANNELS=450
# Max sleep between reconnect attempts (seconds). Exponential backoff caps here.
DERIBIT_WS_RECONNECT_MAX_DELAY_SECONDS=60
# Emit a `deribit_ws_degraded` outbox heartbeat every N failed reconnect attempts.
# Set to 0 to disable heartbeats. Reconnect retries indefinitely until shutdown.
DERIBIT_WS_RECONNECT_HEARTBEAT_ATTEMPTS=10
# Max age (seconds) for cached prices in get_current_price before falling back
# to a fresh REST fetch. Drop low to catch WS-glitch staleness.
DERIBIT_PRICE_CACHE_MAX_AGE_SECONDS=3
# Alert sample-staleness watchdog: catches the case where the WS ticker stream
# goes silent (e.g. a resubscribe failed after reconnect) and the alert
# evaluator keeps trusting an old _last_price. Check cadence + max sample age.
# Set either to 0 to disable the watchdog. On stale, the watchdog emits a
# `deribit_ws_alert_stale` outbox event, forces a server-side resubscribe,
# and pulls a fresh REST ticker to re-fire any threshold the WS gap missed.
DERIBIT_ALERT_STALE_CHECK_SECONDS=30
DERIBIT_ALERT_STALE_THRESHOLD_SECONDS=60

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# =============================================================================
# Docker-compose only — not consumed by the Python app
# =============================================================================
# Published container image used by docker-compose.yml. Override only when
# testing a fork, a pinned sha tag, or a locally built image.
DERIBIT_MCP_IMAGE=ghcr.io/schroejahr2/deribit-mcp:latest

# Host interface to bind the HTTP port to. Defaults to 127.0.0.1 (loopback
# only) so a fresh clone never accidentally exposes the server. Set to
# 0.0.0.0 for "all interfaces", or a specific LAN IP (e.g. 192.0.2.10) to
# pin to one interface.
BIND_IP=127.0.0.1
